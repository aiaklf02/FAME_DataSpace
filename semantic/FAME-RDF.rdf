<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:foaf="http://xmlns.com/foaf/0.1/"
    xmlns:vcard="http://www.w3.org/2006/vcard/ns#"
    xmlns:schema="http://schema.org/"
    xmlns:fame="http://fame.eu/ontology#"
    xmlns:data="http://fame.eu/data#">


<!-- ─────────────────────────────────────────────────────────────────────────── 
     NAMESPACE DECLARATIONS AND ONTOLOGY METADATA
     ─────────────────────────────────────────────────────────────────────────── -->

<rdf:Description rdf:about="http://fame.eu/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <dc:title xml:lang="en">FAME Financial Data Space RDF Vocabulary</dc:title>
    <dc:title xml:lang="fr">Vocabulaire RDF de l'Espace de Données Financières FAME</dc:title>
    <dc:creator>FAME Data Space Project - Master M2</dc:creator>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-01-11</dc:date>
    <dc:description xml:lang="en">RDF vocabulary for financial entities with data from Yahoo Finance API (JSON), ECB Exchange Rates (XML), Company Financials (CSV), and PostgreSQL Transactions</dc:description>
    <dc:description xml:lang="fr">Vocabulaire RDF pour entités financières avec données de l'API Yahoo Finance (JSON), Taux de Change BCE (XML), Données Financières d'Entreprises (CSV) et Transactions PostgreSQL</dc:description>
    <dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
    <dc:language>en</dc:language>
    <dc:language>fr</dc:language>
</rdf:Description>

<!-- ═══════════════════════════════════════════════════════════════════════════
     RDFS CLASS DEFINITIONS
     ═══════════════════════════════════════════════════════════════════════════ -->

<!-- ─────────────────────────────────────────────────────────────────────────── 
     Core Financial Entity Class
     ─────────────────────────────────────────────────────────────────────────── -->

<rdfs:Class rdf:about="http://fame.eu/ontology#FinancialEntity">
    <rdfs:label xml:lang="en">Financial Entity</rdfs:label>
    <rdfs:label xml:lang="fr">Entité Financière</rdfs:label>
    <rdfs:comment xml:lang="en">A resource representing any entity in the financial domain</rdfs:comment>
    <rdfs:comment xml:lang="fr">Une ressource représentant toute entité du domaine financier</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdfs:Class>

<!-- ─────────────────────────────────────────────────────────────────────────── 
     Financial Instruments
     ─────────────────────────────────────────────────────────────────────────── -->

<rdfs:Class rdf:about="http://fame.eu/ontology#Stock">
    <rdfs:label xml:lang="en">Stock</rdfs:label>
    <rdfs:label xml:lang="fr">Action</rdfs:label>
    <rdfs:comment xml:lang="en">Equity security representing ownership in a corporation</rdfs:comment>
    <rdfs:comment xml:lang="fr">Titre de propriété représentant une participation dans une société</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://fame.eu/ontology#FinancialEntity"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
    <dcterms:source>Yahoo Finance API (JSON)</dcterms:source>
</rdfs:Class>

<rdfs:Class rdf:about="http://fame.eu/ontology#Currency">
    <rdfs:label xml:lang="en">Currency</rdfs:label>
    <rdfs:label xml:lang="fr">Devise</rdfs:label>
    <rdfs:comment xml:lang="en">System of money in general use in a particular country</rdfs:comment>
    <rdfs:comment xml:lang="fr">Système monétaire utilisé dans un pays particulier</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://fame.eu/ontology#FinancialEntity"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
    <dcterms:source>ECB Exchange Rates (XML)</dcterms:source>
</rdfs:Class>

<rdfs:Class rdf:about="http://fame.eu/ontology#ExchangeRate">
    <rdfs:label xml:lang="en">Exchange Rate</rdfs:label>
    <rdfs:label xml:lang="fr">Taux de Change</rdfs:label>
    <rdfs:comment xml:lang="en">Rate at which one currency will be exchanged for another</rdfs:comment>
    <rdfs:comment xml:lang="fr">Taux auquel une devise sera échangée contre une autre</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://fame.eu/ontology#FinancialEntity"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
    <dcterms:source>ECB Exchange Rates (XML)</dcterms:source>
</rdfs:Class>

<!-- ─────────────────────────────────────────────────────────────────────────── 
     Economic Actors
     ─────────────────────────────────────────────────────────────────────────── -->

<rdfs:Class rdf:about="http://fame.eu/ontology#Company">
    <rdfs:label xml:lang="en">Company</rdfs:label>
    <rdfs:label xml:lang="fr">Entreprise</rdfs:label>
    <rdfs:comment xml:lang="en">Legal entity representing a business organization</rdfs:comment>
    <rdfs:comment xml:lang="fr">Entité légale représentant une organisation commerciale</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://fame.eu/ontology#FinancialEntity"/>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/Organization"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
    <dcterms:source>S&amp;P500/NYSE/NASDAQ CSV Files</dcterms:source>
</rdfs:Class>

<rdfs:Class rdf:about="http://fame.eu/ontology#Sector">
    <rdfs:label xml:lang="en">Industry Sector</rdfs:label>
    <rdfs:label xml:lang="fr">Secteur d'Activité</rdfs:label>
    <rdfs:comment xml:lang="en">Category of business activity within the economy</rdfs:comment>
    <rdfs:comment xml:lang="fr">Catégorie d'activité économique au sein de l'économie</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://fame.eu/ontology#FinancialEntity"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdfs:Class>

<!-- ─────────────────────────────────────────────────────────────────────────── 
     Transactions
     ─────────────────────────────────────────────────────────────────────────── -->

<rdfs:Class rdf:about="http://fame.eu/ontology#Transaction">
    <rdfs:label xml:lang="en">Transaction</rdfs:label>
    <rdfs:label xml:lang="fr">Transaction</rdfs:label>
    <rdfs:comment xml:lang="en">Exchange or transfer of goods, services, or funds</rdfs:comment>
    <rdfs:comment xml:lang="fr">Échange ou transfert de biens, services ou fonds</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://fame.eu/ontology#FinancialEntity"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
    <dcterms:source>PostgreSQL Transactions Database</dcterms:source>
</rdfs:Class>

<rdfs:Class rdf:about="http://fame.eu/ontology#Transfer">
    <rdfs:label xml:lang="en">Transfer</rdfs:label>
    <rdfs:label xml:lang="fr">Virement</rdfs:label>
    <rdfs:comment xml:lang="en">Movement of funds from one account to another</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://fame.eu/ontology#Transaction"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdfs:Class>

<rdfs:Class rdf:about="http://fame.eu/ontology#Payment">
    <rdfs:label xml:lang="en">Payment</rdfs:label>
    <rdfs:label xml:lang="fr">Paiement</rdfs:label>
    <rdfs:comment xml:lang="en">Transfer of value to settle an obligation</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://fame.eu/ontology#Transaction"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdfs:Class>

<rdfs:Class rdf:about="http://fame.eu/ontology#Deposit">
    <rdfs:label xml:lang="en">Deposit</rdfs:label>
    <rdfs:label xml:lang="fr">Dépôt</rdfs:label>
    <rdfs:comment xml:lang="en">Placement of funds into an account</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://fame.eu/ontology#Transaction"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdfs:Class>

<!-- ─────────────────────────────────────────────────────────────────────────── 
     Infrastructure
     ─────────────────────────────────────────────────────────────────────────── -->

<rdfs:Class rdf:about="http://fame.eu/ontology#StockExchange">
    <rdfs:label xml:lang="en">Stock Exchange</rdfs:label>
    <rdfs:label xml:lang="fr">Bourse</rdfs:label>
    <rdfs:comment xml:lang="en">Marketplace where securities are traded</rdfs:comment>
    <rdfs:comment xml:lang="fr">Marché où les titres sont négociés</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://fame.eu/ontology#FinancialEntity"/>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdfs:Class>

<!-- ─────────────────────────────────────────────────────────────────────────── 
     Data Sources (Provenance)
     ─────────────────────────────────────────────────────────────────────────── -->

<rdfs:Class rdf:about="http://fame.eu/ontology#DataSource">
    <rdfs:label xml:lang="en">Data Source</rdfs:label>
    <rdfs:label xml:lang="fr">Source de Données</rdfs:label>
    <rdfs:comment xml:lang="en">Origin of data for provenance tracking</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdfs:Class>

<!-- ═══════════════════════════════════════════════════════════════════════════
     RDF PROPERTY DEFINITIONS
     ═══════════════════════════════════════════════════════════════════════════ -->

<!-- ─────────────────────────────────────────────────────────────────────────── 
     Object Properties (Relations between resources)
     ─────────────────────────────────────────────────────────────────────────── -->

<rdf:Property rdf:about="http://fame.eu/ontology#hasCurrency">
    <rdfs:label xml:lang="en">has currency</rdfs:label>
    <rdfs:label xml:lang="fr">a pour devise</rdfs:label>
    <rdfs:comment xml:lang="en">Links a financial instrument to its currency</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Stock"/>
    <rdfs:range rdf:resource="http://fame.eu/ontology#Currency"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#tradedOn">
    <rdfs:label xml:lang="en">traded on</rdfs:label>
    <rdfs:label xml:lang="fr">négocié sur</rdfs:label>
    <rdfs:comment xml:lang="en">Stock exchange where a security is traded</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Stock"/>
    <rdfs:range rdf:resource="http://fame.eu/ontology#StockExchange"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#issuedBy">
    <rdfs:label xml:lang="en">issued by</rdfs:label>
    <rdfs:label xml:lang="fr">émis par</rdfs:label>
    <rdfs:comment xml:lang="en">Company that issued the stock</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Stock"/>
    <rdfs:range rdf:resource="http://fame.eu/ontology#Company"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#belongsToSector">
    <rdfs:label xml:lang="en">belongs to sector</rdfs:label>
    <rdfs:label xml:lang="fr">appartient au secteur</rdfs:label>
    <rdfs:comment xml:lang="en">Industry sector of a company</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Company"/>
    <rdfs:range rdf:resource="http://fame.eu/ontology#Sector"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#baseCurrency">
    <rdfs:label xml:lang="en">base currency</rdfs:label>
    <rdfs:label xml:lang="fr">devise de base</rdfs:label>
    <rdfs:comment xml:lang="en">The currency being converted from</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#ExchangeRate"/>
    <rdfs:range rdf:resource="http://fame.eu/ontology#Currency"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#targetCurrency">
    <rdfs:label xml:lang="en">target currency</rdfs:label>
    <rdfs:label xml:lang="fr">devise cible</rdfs:label>
    <rdfs:comment xml:lang="en">The currency being converted to</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#ExchangeRate"/>
    <rdfs:range rdf:resource="http://fame.eu/ontology#Currency"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#transactionCurrency">
    <rdfs:label xml:lang="en">transaction currency</rdfs:label>
    <rdfs:label xml:lang="fr">devise de transaction</rdfs:label>
    <rdfs:comment xml:lang="en">Currency in which a transaction is denominated</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Transaction"/>
    <rdfs:range rdf:resource="http://fame.eu/ontology#Currency"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#hasSource">
    <rdfs:label xml:lang="en">has data source</rdfs:label>
    <rdfs:label xml:lang="fr">a pour source de données</rdfs:label>
    <rdfs:comment xml:lang="en">Provenance link to data source</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#FinancialEntity"/>
    <rdfs:range rdf:resource="http://fame.eu/ontology#DataSource"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<!-- ─────────────────────────────────────────────────────────────────────────── 
     Datatype Properties (Literal values)
     ─────────────────────────────────────────────────────────────────────────── -->

<rdf:Property rdf:about="http://fame.eu/ontology#symbol">
    <rdfs:label xml:lang="en">ticker symbol</rdfs:label>
    <rdfs:label xml:lang="fr">symbole boursier</rdfs:label>
    <rdfs:comment xml:lang="en">Trading symbol for a stock</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Stock"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#price">
    <rdfs:label xml:lang="en">current price</rdfs:label>
    <rdfs:label xml:lang="fr">prix actuel</rdfs:label>
    <rdfs:comment xml:lang="en">Current trading price of a stock</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Stock"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#volume">
    <rdfs:label xml:lang="en">trading volume</rdfs:label>
    <rdfs:label xml:lang="fr">volume d'échanges</rdfs:label>
    <rdfs:comment xml:lang="en">Number of shares traded</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Stock"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#marketCap">
    <rdfs:label xml:lang="en">market capitalization</rdfs:label>
    <rdfs:label xml:lang="fr">capitalisation boursière</rdfs:label>
    <rdfs:comment xml:lang="en">Total market value of outstanding shares</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Stock"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#currencyCode">
    <rdfs:label xml:lang="en">currency code</rdfs:label>
    <rdfs:label xml:lang="fr">code de devise</rdfs:label>
    <rdfs:comment xml:lang="en">ISO 4217 currency code</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Currency"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#rate">
    <rdfs:label xml:lang="en">exchange rate</rdfs:label>
    <rdfs:label xml:lang="fr">taux de change</rdfs:label>
    <rdfs:comment xml:lang="en">Conversion rate between currencies</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#ExchangeRate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#amount">
    <rdfs:label xml:lang="en">amount</rdfs:label>
    <rdfs:label xml:lang="fr">montant</rdfs:label>
    <rdfs:comment xml:lang="en">Monetary amount of a transaction</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Transaction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#transactionId">
    <rdfs:label xml:lang="en">transaction ID</rdfs:label>
    <rdfs:label xml:lang="fr">identifiant de transaction</rdfs:label>
    <rdfs:comment xml:lang="en">Unique identifier for a transaction</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Transaction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<rdf:Property rdf:about="http://fame.eu/ontology#status">
    <rdfs:label xml:lang="en">transaction status</rdfs:label>
    <rdfs:label xml:lang="fr">statut de transaction</rdfs:label>
    <rdfs:comment xml:lang="en">Current status of a transaction</rdfs:comment>
    <rdfs:domain rdf:resource="http://fame.eu/ontology#Transaction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://fame.eu/ontology"/>
</rdf:Property>

<!-- ═══════════════════════════════════════════════════════════════════════════
     DATA SOURCE INSTANCES (Provenance)
     ═══════════════════════════════════════════════════════════════════════════ -->

<rdf:Description rdf:about="http://fame.eu/data#YahooFinanceAPI">
    <rdf:type rdf:resource="http://fame.eu/ontology#DataSource"/>
    <rdfs:label>Yahoo Finance API</rdfs:label>
    <dc:description>Real-time stock data via REST API (JSON format)</dc:description>
    <dcterms:format>application/json</dcterms:format>
    <fame:sourceType>REST API</fame:sourceType>
    <fame:sourceURL>https://query1.finance.yahoo.com/v8/finance/chart/</fame:sourceURL>
</rdf:Description>

<rdf:Description rdf:about="http://fame.eu/data#ECB_XML">
    <rdf:type rdf:resource="http://fame.eu/ontology#DataSource"/>
    <rdfs:label>ECB Exchange Rates</rdfs:label>
    <dc:description>European Central Bank forex rates (XML format)</dc:description>
    <dcterms:format>application/xml</dcterms:format>
    <fame:sourceType>XML Feed</fame:sourceType>
    <fame:sourceURL>https://www.ecb.europa.eu/stats/eurofxref/</fame:sourceURL>
</rdf:Description>

<rdf:Description rdf:about="http://fame.eu/data#CSV_Financials">
    <rdf:type rdf:resource="http://fame.eu/ontology#DataSource"/>
    <rdfs:label>CSV Financial Data</rdfs:label>
    <dc:description>S&amp;P500, NYSE, NASDAQ listings (CSV format)</dc:description>
    <dcterms:format>text/csv</dcterms:format>
    <fame:sourceType>File System</fame:sourceType>
    <fame:recordCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22614</fame:recordCount>
</rdf:Description>

<rdf:Description rdf:about="http://fame.eu/data#PostgreSQL_Transactions">
    <rdf:type rdf:resource="http://fame.eu/ontology#DataSource"/>
    <rdfs:label>PostgreSQL Transactions</rdfs:label>
    <dc:description>Financial transactions database (SQL format)</dc:description>
    <dcterms:format>application/sql</dcterms:format>
    <fame:sourceType>Relational Database</fame:sourceType>
    <fame:recordCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">759</fame:recordCount>
</rdf:Description>

<!-- ═══════════════════════════════════════════════════════════════════════════
     STOCK EXCHANGES
     ═══════════════════════════════════════════════════════════════════════════ -->

<rdf:Description rdf:about="http://fame.eu/data#NASDAQ">
    <rdf:type rdf:resource="http://fame.eu/ontology#StockExchange"/>
    <rdfs:label>NASDAQ</rdfs:label>
    <foaf:name>NASDAQ</foaf:name>
    <fame:exchangeCode>NMS</fame:exchangeCode>
    <vcard:country-name>United States</vcard:country-name>
    <schema:address>
        <schema:PostalAddress>
            <schema:addressCountry>US</schema:addressCountry>
            <schema:addressLocality>New York</schema:addressLocality>
        </schema:PostalAddress>
    </schema:address>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/NASDAQ"/>
</rdf:Description>

<rdf:Description rdf:about="http://fame.eu/data#NYSE">
    <rdf:type rdf:resource="http://fame.eu/ontology#StockExchange"/>
    <rdfs:label>New York Stock Exchange</rdfs:label>
    <foaf:name>New York Stock Exchange</foaf:name>
    <fame:exchangeCode>NYQ</fame:exchangeCode>
    <vcard:country-name>United States</vcard:country-name>
    <schema:address>
        <schema:PostalAddress>
            <schema:addressCountry>US</schema:addressCountry>
            <schema:addressLocality>New York</schema:addressLocality>
            <schema:streetAddress>11 Wall Street</schema:streetAddress>
        </schema:PostalAddress>
    </schema:address>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/New_York_Stock_Exchange"/>
</rdf:Description>

<rdf:Description rdf:about="http://fame.eu/data#EURONEXT_Paris">
    <rdf:type rdf:resource="http://fame.eu/ontology#StockExchange"/>
    <rdfs:label xml:lang="fr">Euronext Paris</rdfs:label>
    <foaf:name>Euronext Paris</foaf:name>
    <fame:exchangeCode>PAR</fame:exchangeCode>
    <vcard:country-name>France</vcard:country-name>
    <schema:address>
        <schema:PostalAddress>
            <schema:addressCountry>FR</schema:addressCountry>
            <schema:addressLocality>Paris</schema:addressLocality>

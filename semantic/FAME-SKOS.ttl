data:Microsoft_Corp a skos:Concept ;
    skos:inScheme fame:scheme ;
    skos:prefLabel "Microsoft Corporation"@en ;
    skos:altLabel "Microsoft" ;
    skos:definition """American multinational technology corporation headquartered 
        in Redmond, Washington"""@en ;
    skos:broader fame:Company ;
    skos:related data:Technology , data:MSFT ;
    dcterms:spatial "Redmond, Washington" ;
    dcterms:source "S&P500/NYSE/NASDAQ CSV Files" .

data:Alphabet_Inc a skos:Concept ;
    skos:inScheme fame:scheme ;
    skos:prefLabel "Alphabet Inc."@en ;
    skos:altLabel "Google Parent Company" ;
    skos:definition """American multinational conglomerate headquartered 
        in Mountain View, California"""@en ;

    <!-- ═══════════════════════════════════════════════════════════════════════
         SECTION 9: COMPANIES (Source 3: CSV - 22,614 records)
         ═══════════════════════════════════════════════════════════════════════ -->

    <fame:Company rdf:about="&data;Apple_Inc">
        <rdfs:label>Apple Inc.</rdfs:label>
        <fame:companyName>Apple Inc.</fame:companyName>
        <fame:headquarters>Cupertino, California</fame:headquarters>
        <fame:belongsToSector rdf:resource="&data;Technology"/>
        <fame:hasSource rdf:resource="&data;CSV_Financials"/>
    </fame:Company>


<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY fame "http://fame.eu/ontology#">
    <!ENTITY data "http://fame.eu/data#">
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
    <!ENTITY owl "http://www.w3.org/2002/07/owl#">
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
    <!ENTITY dc "http://purl.org/dc/elements/1.1/">
    <!ENTITY skos "http://www.w3.org/2004/02/skos/core#">
]>

<rdf:RDF xmlns="http://fame.eu/ontology#"
     xml:base="http://fame.eu/ontology"
     xmlns:fame="http://fame.eu/ontology#"
     xmlns:data="http://fame.eu/data#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">

    <!-- ═══════════════════════════════════════════════════════════════════════
         FAME Financial Data Space - Complete Ontology with Real Data
         For Protégé - Open this file directly in Protégé
         
         Data Sources:
         - Source 1: Yahoo Finance API (82 stocks) - JSON
         - Source 2: ECB Exchange Rates (29 currencies) - XML
         - Source 3: Company Financials (22,614 records) - CSV
         - Source 4: Transactions (759 records) - PostgreSQL
         ═══════════════════════════════════════════════════════════════════════ -->

    <owl:Ontology rdf:about="http://fame.eu/ontology">
        <dc:title>FAME Financial Data Space - Complete Ontology with Data</dc:title>
        <dc:description>Ontology with real instances from 4 heterogeneous data sources (API JSON, XML, CSV, SQL)</dc:description>
        <dc:creator>FAME Data Space Project - Master M2</dc:creator>
        <dc:date>2026-01-11</dc:date>
        <owl:versionInfo>2.0.0</owl:versionInfo>
        <rdfs:comment>Open in Protégé to visualize classes, properties and instances</rdfs:comment>
    </owl:Ontology>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SECTION 1: CLASSES (TBox)
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Base Class -->
    <owl:Class rdf:about="&fame;FinancialEntity">
        <rdfs:label xml:lang="en">Financial Entity</rdfs:label>
        <rdfs:label xml:lang="fr">Entité Financière</rdfs:label>
        <rdfs:comment>Base class for all financial entities</rdfs:comment>
    </owl:Class>

    <!-- Stock Class (Source 1: Yahoo API) -->
    <owl:Class rdf:about="&fame;Stock">
        <rdfs:subClassOf rdf:resource="&fame;FinancialEntity"/>
        <rdfs:label xml:lang="en">Stock</rdfs:label>
        <rdfs:label xml:lang="fr">Action</rdfs:label>
        <rdfs:comment>Equity security from Yahoo Finance API (JSON)</rdfs:comment>
        <skos:altLabel>Equity</skos:altLabel>
        <skos:altLabel>Share</skos:altLabel>
    </owl:Class>

    <!-- Currency Class (Source 2: ECB XML) -->
    <owl:Class rdf:about="&fame;Currency">
        <rdfs:subClassOf rdf:resource="&fame;FinancialEntity"/>
        <rdfs:label xml:lang="en">Currency</rdfs:label>
        <rdfs:label xml:lang="fr">Devise</rdfs:label>
        <rdfs:comment>Currency from ECB Exchange Rates (XML)</rdfs:comment>
    </owl:Class>

    <!-- Exchange Rate Class (Source 2: ECB XML) -->
    <owl:Class rdf:about="&fame;ExchangeRate">
        <rdfs:subClassOf rdf:resource="&fame;FinancialEntity"/>
        <rdfs:label xml:lang="en">Exchange Rate</rdfs:label>
        <rdfs:label xml:lang="fr">Taux de Change</rdfs:label>
        <rdfs:comment>Exchange rate from ECB (XML feed)</rdfs:comment>
    </owl:Class>

    <!-- Company Class (Source 3: CSV) -->
    <owl:Class rdf:about="&fame;Company">
        <rdfs:subClassOf rdf:resource="&fame;FinancialEntity"/>
        <rdfs:label xml:lang="en">Company</rdfs:label>
        <rdfs:label xml:lang="fr">Entreprise</rdfs:label>
        <rdfs:comment>Company from S&amp;P500/NYSE/NASDAQ CSV files</rdfs:comment>
    </owl:Class>

    <!-- Transaction Class (Source 4: PostgreSQL) -->
    <owl:Class rdf:about="&fame;Transaction">
        <rdfs:subClassOf rdf:resource="&fame;FinancialEntity"/>
        <rdfs:label xml:lang="en">Transaction</rdfs:label>
        <rdfs:label xml:lang="fr">Transaction</rdfs:label>
        <rdfs:comment>Financial transaction from PostgreSQL database</rdfs:comment>
    </owl:Class>

    <!-- Transaction Types -->
    <owl:Class rdf:about="&fame;Transfer">
        <rdfs:subClassOf rdf:resource="&fame;Transaction"/>
        <rdfs:label xml:lang="en">Transfer</rdfs:label>
        <rdfs:label xml:lang="fr">Virement</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&fame;Payment">
        <rdfs:subClassOf rdf:resource="&fame;Transaction"/>
        <rdfs:label xml:lang="en">Payment</rdfs:label>
        <rdfs:label xml:lang="fr">Paiement</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&fame;Deposit">
        <rdfs:subClassOf rdf:resource="&fame;Transaction"/>
        <rdfs:label xml:lang="en">Deposit</rdfs:label>
        <rdfs:label xml:lang="fr">Dépôt</rdfs:label>
    </owl:Class>

    <!-- Stock Exchange Class -->
    <owl:Class rdf:about="&fame;StockExchange">
        <rdfs:subClassOf rdf:resource="&fame;FinancialEntity"/>
        <rdfs:label xml:lang="en">Stock Exchange</rdfs:label>
        <rdfs:label xml:lang="fr">Bourse</rdfs:label>
    </owl:Class>

    <!-- Sector Class -->
    <owl:Class rdf:about="&fame;Sector">
        <rdfs:subClassOf rdf:resource="&fame;FinancialEntity"/>
        <rdfs:label xml:lang="en">Industry Sector</rdfs:label>
        <rdfs:label xml:lang="fr">Secteur d'Activité</rdfs:label>
    </owl:Class>

    <!-- Data Source Class (Provenance) -->
    <owl:Class rdf:about="&fame;DataSource">
        <rdfs:label xml:lang="en">Data Source</rdfs:label>
        <rdfs:comment>Provenance tracking for data sources</rdfs:comment>
    </owl:Class>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SECTION 2: OBJECT PROPERTIES
         ═══════════════════════════════════════════════════════════════════════ -->

    <owl:ObjectProperty rdf:about="&fame;hasCurrency">
        <rdfs:domain rdf:resource="&fame;Stock"/>
        <rdfs:range rdf:resource="&fame;Currency"/>
        <rdfs:label>has currency</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&fame;tradedOn">
        <rdfs:domain rdf:resource="&fame;Stock"/>
        <rdfs:range rdf:resource="&fame;StockExchange"/>
        <rdfs:label>traded on</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&fame;issuedBy">
        <rdfs:domain rdf:resource="&fame;Stock"/>
        <rdfs:range rdf:resource="&fame;Company"/>
        <rdfs:label>issued by</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&fame;belongsToSector">
        <rdfs:domain rdf:resource="&fame;Company"/>
        <rdfs:range rdf:resource="&fame;Sector"/>
        <rdfs:label>belongs to sector</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&fame;baseCurrency">
        <rdfs:domain rdf:resource="&fame;ExchangeRate"/>
        <rdfs:range rdf:resource="&fame;Currency"/>
        <rdfs:label>base currency</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&fame;targetCurrency">
        <rdfs:domain rdf:resource="&fame;ExchangeRate"/>
        <rdfs:range rdf:resource="&fame;Currency"/>
        <rdfs:label>target currency</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&fame;transactionCurrency">
        <rdfs:domain rdf:resource="&fame;Transaction"/>
        <rdfs:range rdf:resource="&fame;Currency"/>
        <rdfs:label>transaction currency</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&fame;hasSource">
        <rdfs:range rdf:resource="&fame;DataSource"/>
        <rdfs:label>has data source</rdfs:label>
        <rdfs:comment>Provenance: links entity to its data source</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SECTION 3: DATA PROPERTIES
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Stock Properties -->
    <owl:DatatypeProperty rdf:about="&fame;symbol">
        <rdfs:domain rdf:resource="&fame;Stock"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label>ticker symbol</rdfs:label>
        <skos:altLabel>ticker</skos:altLabel>
        <skos:altLabel>code</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fame;price">
        <rdfs:domain rdf:resource="&fame;Stock"/>
        <rdfs:range rdf:resource="&xsd;decimal"/>
        <rdfs:label>current price</rdfs:label>
        <skos:altLabel>value</skos:altLabel>
        <skos:altLabel>quote</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fame;volume">
        <rdfs:domain rdf:resource="&fame;Stock"/>
        <rdfs:range rdf:resource="&xsd;integer"/>
        <rdfs:label>trading volume</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fame;marketCap">
        <rdfs:domain rdf:resource="&fame;Stock"/>
        <rdfs:range rdf:resource="&xsd;decimal"/>
        <rdfs:label>market capitalization</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fame;changePercent">
        <rdfs:domain rdf:resource="&fame;Stock"/>
        <rdfs:range rdf:resource="&xsd;decimal"/>
        <rdfs:label>change percent</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Exchange Rate Properties -->
    <owl:DatatypeProperty rdf:about="&fame;rate">
        <rdfs:domain rdf:resource="&fame;ExchangeRate"/>
        <rdfs:range rdf:resource="&xsd;decimal"/>
        <rdfs:label>exchange rate</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fame;rateDate">
        <rdfs:domain rdf:resource="&fame;ExchangeRate"/>
        <rdfs:range rdf:resource="&xsd;date"/>
        <rdfs:label>rate date</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Company Properties -->
    <owl:DatatypeProperty rdf:about="&fame;companyName">
        <rdfs:domain rdf:resource="&fame;Company"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label>company name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fame;headquarters">
        <rdfs:domain rdf:resource="&fame;Company"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label>headquarters</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Transaction Properties -->
    <owl:DatatypeProperty rdf:about="&fame;transactionId">
        <rdfs:domain rdf:resource="&fame;Transaction"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label>transaction ID</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fame;amount">
        <rdfs:domain rdf:resource="&fame;Transaction"/>
        <rdfs:range rdf:resource="&xsd;decimal"/>
        <rdfs:label>amount</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fame;senderName">
        <rdfs:domain rdf:resource="&fame;Transaction"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label>sender name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fame;receiverName">
        <rdfs:domain rdf:resource="&fame;Transaction"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label>receiver name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fame;status">
        <rdfs:domain rdf:resource="&fame;Transaction"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label>transaction status</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fame;timestamp">
        <rdfs:range rdf:resource="&xsd;dateTime"/>
        <rdfs:label>timestamp</rdfs:label>
    </owl:DatatypeProperty>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SECTION 4: DATA SOURCES (Provenance)
         ═══════════════════════════════════════════════════════════════════════ -->

    <fame:DataSource rdf:about="&data;YahooFinanceAPI">
        <rdfs:label>Yahoo Finance API</rdfs:label>
        <dc:description>Real-time stock data via REST API (JSON format)</dc:description>
        <fame:sourceFormat>JSON</fame:sourceFormat>
        <fame:sourceType>REST API</fame:sourceType>
        <fame:sourceURL>https://query1.finance.yahoo.com/v8/finance/chart/</fame:sourceURL>
    </fame:DataSource>

    <fame:DataSource rdf:about="&data;ECB_XML">
        <rdfs:label>ECB Exchange Rates</rdfs:label>
        <dc:description>European Central Bank forex rates (XML format)</dc:description>
        <fame:sourceFormat>XML</fame:sourceFormat>
        <fame:sourceType>XML Feed</fame:sourceType>
        <fame:sourceURL>https://www.ecb.europa.eu/stats/eurofxref/</fame:sourceURL>
    </fame:DataSource>

    <fame:DataSource rdf:about="&data;CSV_Financials">
        <rdfs:label>CSV Financial Data</rdfs:label>
        <dc:description>S&amp;P500, NYSE, NASDAQ listings (CSV format)</dc:description>
        <fame:sourceFormat>CSV</fame:sourceFormat>
        <fame:sourceType>File System</fame:sourceType>
    </fame:DataSource>

    <fame:DataSource rdf:about="&data;PostgreSQL_Transactions">
        <rdfs:label>PostgreSQL Transactions</rdfs:label>
        <dc:description>Financial transactions database (SQL format)</dc:description>
        <fame:sourceFormat>SQL</fame:sourceFormat>
        <fame:sourceType>Relational Database</fame:sourceType>
    </fame:DataSource>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SECTION 5: STOCK EXCHANGES
         ═══════════════════════════════════════════════════════════════════════ -->

    <fame:StockExchange rdf:about="&data;NASDAQ">
        <rdfs:label>NASDAQ</rdfs:label>
        <fame:exchangeCode>NMS</fame:exchangeCode>
        <fame:country>United States</fame:country>
    </fame:StockExchange>

    <fame:StockExchange rdf:about="&data;NYSE">
        <rdfs:label>New York Stock Exchange</rdfs:label>
        <fame:exchangeCode>NYQ</fame:exchangeCode>
        <fame:country>United States</fame:country>
    </fame:StockExchange>

    <fame:StockExchange rdf:about="&data;EURONEXT_Paris">
        <rdfs:label>Euronext Paris</rdfs:label>
        <fame:exchangeCode>PAR</fame:exchangeCode>
        <fame:country>France</fame:country>
    </fame:StockExchange>

    <fame:StockExchange rdf:about="&data;XETRA">
        <rdfs:label>XETRA Frankfurt</rdfs:label>
        <fame:exchangeCode>GER</fame:exchangeCode>
        <fame:country>Germany</fame:country>
    </fame:StockExchange>

    <fame:StockExchange rdf:about="&data;LSE">
        <rdfs:label>London Stock Exchange</rdfs:label>
        <fame:exchangeCode>LON</fame:exchangeCode>
        <fame:country>United Kingdom</fame:country>
    </fame:StockExchange>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SECTION 6: CURRENCIES (Source 2: ECB XML)
         ═══════════════════════════════════════════════════════════════════════ -->

    <fame:Currency rdf:about="&data;EUR">
        <rdfs:label>Euro</rdfs:label>
        <fame:currencyCode>EUR</fame:currencyCode>
        <fame:currencySymbol>€</fame:currencySymbol>
        <fame:hasSource rdf:resource="&data;ECB_XML"/>
    </fame:Currency>

    <fame:Currency rdf:about="&data;USD">
        <rdfs:label>US Dollar</rdfs:label>
        <fame:currencyCode>USD</fame:currencyCode>
        <fame:currencySymbol>$</fame:currencySymbol>
        <fame:hasSource rdf:resource="&data;ECB_XML"/>
    </fame:Currency>

    <fame:Currency rdf:about="&data;GBP">
        <rdfs:label>British Pound</rdfs:label>
        <fame:currencyCode>GBP</fame:currencyCode>
        <fame:currencySymbol>£</fame:currencySymbol>
        <fame:hasSource rdf:resource="&data;ECB_XML"/>
    </fame:Currency>

    <fame:Currency rdf:about="&data;JPY">
        <rdfs:label>Japanese Yen</rdfs:label>
        <fame:currencyCode>JPY</fame:currencyCode>
        <fame:currencySymbol>¥</fame:currencySymbol>
        <fame:hasSource rdf:resource="&data;ECB_XML"/>
    </fame:Currency>

    <fame:Currency rdf:about="&data;CHF">
        <rdfs:label>Swiss Franc</rdfs:label>
        <fame:currencyCode>CHF</fame:currencyCode>
        <fame:currencySymbol>CHF</fame:currencySymbol>
        <fame:hasSource rdf:resource="&data;ECB_XML"/>
    </fame:Currency>

    <fame:Currency rdf:about="&data;CNY">
        <rdfs:label>Chinese Yuan</rdfs:label>
        <fame:currencyCode>CNY</fame:currencyCode>
        <fame:currencySymbol>¥</fame:currencySymbol>
        <fame:hasSource rdf:resource="&data;ECB_XML"/>
    </fame:Currency>

    <fame:Currency rdf:about="&data;AUD">
        <rdfs:label>Australian Dollar</rdfs:label>
        <fame:currencyCode>AUD</fame:currencyCode>
        <fame:hasSource rdf:resource="&data;ECB_XML"/>
    </fame:Currency>

    <fame:Currency rdf:about="&data;CAD">
        <rdfs:label>Canadian Dollar</rdfs:label>
        <fame:currencyCode>CAD</fame:currencyCode>
        <fame:hasSource rdf:resource="&data;ECB_XML"/>
    </fame:Currency>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SECTION 7: SECTORS (Source 3: CSV)
         ═══════════════════════════════════════════════════════════════════════ -->

    <fame:Sector rdf:about="&data;Technology">
        <rdfs:label>Information Technology</rdfs:label>
        <fame:hasSource rdf:resource="&data;CSV_Financials"/>
    </fame:Sector>

    <fame:Sector rdf:about="&data;Financials">
        <rdfs:label>Financials</rdfs:label>
        <fame:hasSource rdf:resource="&data;CSV_Financials"/>
    </fame:Sector>

    <fame:Sector rdf:about="&data;Healthcare">
        <rdfs:label>Health Care</rdfs:label>
        <fame:hasSource rdf:resource="&data;CSV_Financials"/>
    </fame:Sector>

    <fame:Sector rdf:about="&data;ConsumerDiscretionary">
        <rdfs:label>Consumer Discretionary</rdfs:label>
        <fame:hasSource rdf:resource="&data;CSV_Financials"/>
    </fame:Sector>

    <fame:Sector rdf:about="&data;Communication">
        <rdfs:label>Communication Services</rdfs:label>
        <fame:hasSource rdf:resource="&data;CSV_Financials"/>
    </fame:Sector>

    <fame:Sector rdf:about="&data;Industrials">
        <rdfs:label>Industrials</rdfs:label>
        <fame:hasSource rdf:resource="&data;CSV_Financials"/>
    </fame:Sector>

    <fame:Sector rdf:about="&data;Energy">
        <rdfs:label>Energy</rdfs:label>
        <fame:hasSource rdf:resource="&data;CSV_Financials"/>
    </fame:Sector>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SECTION 8: EXCHANGE RATES (Source 2: ECB XML - 215,699 records)
         ═══════════════════════════════════════════════════════════════════════ -->

    <fame:ExchangeRate rdf:about="&data;EUR_USD_20260110">

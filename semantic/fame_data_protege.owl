    <fame:ExchangeRate rdf:about="&data;EUR_CNY_20260110">
        <rdfs:label>EUR/CNY 2026-01-10</rdfs:label>
        <fame:baseCurrency rdf:resource="&data;EUR"/>
        <fame:targetCurrency rdf:resource="&data;CNY"/>

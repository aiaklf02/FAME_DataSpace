<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:dct="http://purl.org/dc/terms/">

    <!-- ============================================
         FAME Financial Vocabulary (SKOS)
         Controlled vocabulary for financial terms
         ============================================ -->

    <!-- Concept Scheme -->
    <skos:ConceptScheme rdf:about="http://fame.eu/vocabulary">
        <dc:title>FAME Financial Vocabulary</dc:title>
        <dc:description>SKOS vocabulary for financial data interoperability in the FAME Data Space. Addresses synonym and homonym problems across heterogeneous financial data sources.</dc:description>
        <dc:creator>FAME Data Space Project</dc:creator>
        <dc:date>2026-01-10</dc:date>
        <skos:hasTopConcept rdf:resource="http://fame.eu/vocabulary#MarketData"/>
        <skos:hasTopConcept rdf:resource="http://fame.eu/vocabulary#ForeignExchange"/>
        <skos:hasTopConcept rdf:resource="http://fame.eu/vocabulary#CorporateFinance"/>
        <skos:hasTopConcept rdf:resource="http://fame.eu/vocabulary#Payments"/>
    </skos:ConceptScheme>

    <!-- ==================== TOP CONCEPTS (DOMAINS) ==================== -->

    <!-- Domain: Market Data -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#MarketData">
        <skos:prefLabel xml:lang="en">Market Data</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Données de Marché</skos:prefLabel>
        <skos:definition>Data related to financial markets, including stock prices, trading volumes, and market indices.</skos:definition>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
        <skos:topConceptOf rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- Domain: Foreign Exchange -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#ForeignExchange">
        <skos:prefLabel xml:lang="en">Foreign Exchange</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Change</skos:prefLabel>
        <skos:altLabel xml:lang="en">Forex</skos:altLabel>
        <skos:altLabel xml:lang="en">FX</skos:altLabel>
        <skos:definition>Data related to currency exchange rates and forex markets.</skos:definition>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
        <skos:topConceptOf rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- Domain: Corporate Finance -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#CorporateFinance">
        <skos:prefLabel xml:lang="en">Corporate Finance</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Finance d'Entreprise</skos:prefLabel>
        <skos:definition>Data related to company financials, including statements, ratios, and corporate actions.</skos:definition>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
        <skos:topConceptOf rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- Domain: Payments -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Payments">
        <skos:prefLabel xml:lang="en">Payments</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Paiements</skos:prefLabel>
        <skos:altLabel xml:lang="en">Transactions</skos:altLabel>
        <skos:definition>Data related to financial transactions, transfers, and payment processing.</skos:definition>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
        <skos:topConceptOf rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- ==================== MARKET DATA CONCEPTS ==================== -->

    <!-- Concept: Stock -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Stock">
        <skos:prefLabel xml:lang="en">Stock</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Action</skos:prefLabel>
        <skos:altLabel xml:lang="en">Equity</skos:altLabel>
        <skos:altLabel xml:lang="en">Share</skos:altLabel>
        <skos:altLabel xml:lang="en">Security</skos:altLabel>
        <skos:altLabel xml:lang="fr">Titre</skos:altLabel>
        <skos:altLabel xml:lang="fr">Valeur mobilière</skos:altLabel>
        <skos:definition>An equity security representing ownership shares in a corporation.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#MarketData"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
        <skos:example>AAPL (Apple Inc.), BNP.PA (BNP Paribas)</skos:example>
    </skos:Concept>

    <!-- Concept: Price (SYNONYM RESOLUTION) -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Price">
        <skos:prefLabel xml:lang="en">Price</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Prix</skos:prefLabel>
        <skos:altLabel xml:lang="en">Value</skos:altLabel>
        <skos:altLabel xml:lang="en">Quote</skos:altLabel>
        <skos:altLabel xml:lang="en">Close</skos:altLabel>
        <skos:altLabel xml:lang="en">Last Price</skos:altLabel>
        <skos:altLabel xml:lang="en">Current Price</skos:altLabel>
        <skos:altLabel xml:lang="en">Market Price</skos:altLabel>
        <skos:altLabel xml:lang="fr">Cours</skos:altLabel>
        <skos:altLabel xml:lang="fr">Cotation</skos:altLabel>
        <skos:definition>The monetary value at which a financial instrument is traded.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#MarketData"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
        <skos:scopeNote>Used to unify: current_price, close, last_price, value from different data sources.</skos:scopeNote>
    </skos:Concept>

    <!-- Concept: Volume -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Volume">
        <skos:prefLabel xml:lang="en">Volume</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Volume</skos:prefLabel>
        <skos:altLabel xml:lang="en">Trading Volume</skos:altLabel>
        <skos:altLabel xml:lang="en">Quantity</skos:altLabel>
        <skos:altLabel xml:lang="en">Vol</skos:altLabel>
        <skos:definition>The number of shares or contracts traded during a period.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#MarketData"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- Concept: Ticker Symbol -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#TickerSymbol">
        <skos:prefLabel xml:lang="en">Ticker Symbol</skos:prefLabel>
        <skos:altLabel xml:lang="en">Ticker</skos:altLabel>
        <skos:altLabel xml:lang="en">Symbol</skos:altLabel>
        <skos:altLabel xml:lang="en">Stock Symbol</skos:altLabel>
        <skos:altLabel xml:lang="en">Code</skos:altLabel>
        <skos:definition>A unique abbreviation used to identify a publicly traded security.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#MarketData"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- ==================== FOREIGN EXCHANGE CONCEPTS ==================== -->

    <!-- Concept: Currency -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Currency">
        <skos:prefLabel xml:lang="en">Currency</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Devise</skos:prefLabel>
        <skos:altLabel xml:lang="en">Money</skos:altLabel>
        <skos:altLabel xml:lang="fr">Monnaie</skos:altLabel>
        <skos:definition>A system of money in general use in a particular country or region.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#ForeignExchange"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- Concept: Exchange Rate -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#ExchangeRate">
        <skos:prefLabel xml:lang="en">Exchange Rate</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Taux de Change</skos:prefLabel>
        <skos:altLabel xml:lang="en">FX Rate</skos:altLabel>
        <skos:altLabel xml:lang="en">Forex Rate</skos:altLabel>
        <skos:altLabel xml:lang="en">Rate</skos:altLabel>
        <skos:altLabel xml:lang="en">Conversion Rate</skos:altLabel>
        <skos:definition>The rate at which one currency can be exchanged for another.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#ForeignExchange"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- ==================== CORPORATE FINANCE CONCEPTS ==================== -->

    <!-- Concept: Company (SYNONYM RESOLUTION) -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Company">
        <skos:prefLabel xml:lang="en">Company</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Entreprise</skos:prefLabel>
        <skos:altLabel xml:lang="en">Corporation</skos:altLabel>
        <skos:altLabel xml:lang="en">Firm</skos:altLabel>
        <skos:altLabel xml:lang="en">Enterprise</skos:altLabel>
        <skos:altLabel xml:lang="en">Organization</skos:altLabel>
        <skos:altLabel xml:lang="fr">Société</skos:altLabel>
        <skos:definition>A legal entity formed to conduct business.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#CorporateFinance"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- Concept: Revenue (SYNONYM RESOLUTION) -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Revenue">
        <skos:prefLabel xml:lang="en">Revenue</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Chiffre d'Affaires</skos:prefLabel>
        <skos:altLabel xml:lang="en">Sales</skos:altLabel>
        <skos:altLabel xml:lang="en">Turnover</skos:altLabel>
        <skos:altLabel xml:lang="en">Income</skos:altLabel>
        <skos:altLabel xml:lang="en">Top Line</skos:altLabel>
        <skos:altLabel xml:lang="fr">Recettes</skos:altLabel>
        <skos:altLabel xml:lang="fr">Ventes</skos:altLabel>
        <skos:definition>The total income generated from business operations before expenses.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#CorporateFinance"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
        <skos:scopeNote>Unifies: revenue, sales, turnover from different financial sources.</skos:scopeNote>
    </skos:Concept>

    <!-- Concept: Profit (SYNONYM RESOLUTION) -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Profit">
        <skos:prefLabel xml:lang="en">Profit</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Bénéfice</skos:prefLabel>
        <skos:altLabel xml:lang="en">Net Income</skos:altLabel>
        <skos:altLabel xml:lang="en">Earnings</skos:altLabel>
        <skos:altLabel xml:lang="en">Net Profit</skos:altLabel>
        <skos:altLabel xml:lang="en">Bottom Line</skos:altLabel>
        <skos:altLabel xml:lang="fr">Résultat Net</skos:altLabel>
        <skos:definition>The financial gain after all expenses and taxes have been deducted.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#CorporateFinance"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- Concept: Bank (HOMONYM RESOLUTION) -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Bank_Institution">
        <skos:prefLabel xml:lang="en">Bank (Financial Institution)</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Banque</skos:prefLabel>
        <skos:altLabel xml:lang="en">Banking Institution</skos:altLabel>
        <skos:altLabel xml:lang="en">Financial Institution</skos:altLabel>
        <skos:definition>A financial institution licensed to receive deposits and make loans. NOT to be confused with a river bank or data bank.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#CorporateFinance"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
        <skos:historyNote>Homonym disambiguation: 'Bank' in financial context refers to institution, not geographical feature.</skos:historyNote>
    </skos:Concept>

    <!-- ==================== PAYMENTS CONCEPTS ==================== -->

    <!-- Concept: Transaction -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Transaction">
        <skos:prefLabel xml:lang="en">Transaction</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Transaction</skos:prefLabel>
        <skos:altLabel xml:lang="en">Payment</skos:altLabel>
        <skos:altLabel xml:lang="en">Transfer</skos:altLabel>
        <skos:altLabel xml:lang="en">Operation</skos:altLabel>
        <skos:altLabel xml:lang="fr">Opération</skos:altLabel>
        <skos:altLabel xml:lang="fr">Virement</skos:altLabel>
        <skos:definition>A financial operation involving the transfer of funds between parties.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#Payments"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- Concept: Sender (SYNONYM RESOLUTION) -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Sender">
        <skos:prefLabel xml:lang="en">Sender</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Émetteur</skos:prefLabel>
        <skos:altLabel xml:lang="en">Payer</skos:altLabel>
        <skos:altLabel xml:lang="en">Debitor</skos:altLabel>
        <skos:altLabel xml:lang="en">Originator</skos:altLabel>
        <skos:altLabel xml:lang="en">From Account</skos:altLabel>
        <skos:altLabel xml:lang="fr">Payeur</skos:altLabel>
        <skos:altLabel xml:lang="fr">Débiteur</skos:altLabel>
        <skos:definition>The party initiating a financial transaction (sending funds).</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#Payments"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
        <skos:scopeNote>Unifies: sender, payer, debitor, originator from different payment systems.</skos:scopeNote>
    </skos:Concept>

    <!-- Concept: Receiver (SYNONYM RESOLUTION) -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Receiver">
        <skos:prefLabel xml:lang="en">Receiver</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Bénéficiaire</skos:prefLabel>
        <skos:altLabel xml:lang="en">Payee</skos:altLabel>
        <skos:altLabel xml:lang="en">Creditor</skos:altLabel>
        <skos:altLabel xml:lang="en">Beneficiary</skos:altLabel>
        <skos:altLabel xml:lang="en">To Account</skos:altLabel>
        <skos:altLabel xml:lang="fr">Créancier</skos:altLabel>
        <skos:altLabel xml:lang="fr">Destinataire</skos:altLabel>
        <skos:definition>The party receiving funds in a financial transaction.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#Payments"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- Concept: Amount -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#Amount">
        <skos:prefLabel xml:lang="en">Amount</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Montant</skos:prefLabel>
        <skos:altLabel xml:lang="en">Value</skos:altLabel>
        <skos:altLabel xml:lang="en">Sum</skos:altLabel>
        <skos:altLabel xml:lang="en">Total</skos:altLabel>
        <skos:altLabel xml:lang="fr">Somme</skos:altLabel>
        <skos:definition>The monetary value of a financial transaction.</skos:definition>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#Payments"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
    </skos:Concept>

    <!-- ==================== SEMANTIC MAPPINGS ==================== -->

    <!-- Mapping: ISIN to Ticker -->
    <skos:Concept rdf:about="http://fame.eu/vocabulary#ISIN">
        <skos:prefLabel xml:lang="en">ISIN</skos:prefLabel>
        <skos:definition>International Securities Identification Number - unique identifier for securities.</skos:definition>
        <skos:related rdf:resource="http://fame.eu/vocabulary#TickerSymbol"/>
        <skos:broader rdf:resource="http://fame.eu/vocabulary#MarketData"/>
        <skos:inScheme rdf:resource="http://fame.eu/vocabulary"/>
        <skos:notation>ISO 6166</skos:notation>
    </skos:Concept>

    <!-- Collection: Financial Identifiers -->
    <skos:Collection rdf:about="http://fame.eu/vocabulary#FinancialIdentifiers">
        <skos:prefLabel>Financial Identifiers</skos:prefLabel>
        <skos:member rdf:resource="http://fame.eu/vocabulary#TickerSymbol"/>
        <skos:member rdf:resource="http://fame.eu/vocabulary#ISIN"/>
    </skos:Collection>

    <!-- Collection: Synonym Groups for Data Integration -->
    <skos:Collection rdf:about="http://fame.eu/vocabulary#PriceSynonyms">
        <skos:prefLabel>Price Synonyms (for data unification)</skos:prefLabel>
        <skos:definition>Terms that refer to the same concept across different data sources.</skos:definition>
        <skos:member rdf:resource="http://fame.eu/vocabulary#Price"/>
    </skos:Collection>

</rdf:RDF>

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fame: <http://fame.eu/ontology#> .
@prefix fdata: <http://fame.eu/data/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fdata:dataset a fame:Dataset ;
    dcterms:created "2026-01-10T23:50:47.391732"^^xsd:dateTime ;
    dcterms:creator "FAME Data Space ETL Pipeline" ;
    dcterms:title "FAME Financial Data Space" .

<http://fame.eu/data/stock/AAPL> a fame:Stock ;
    rdfs:label "Apple Inc." ;
    fame:dataDomain "market_data" ;
    fame:hasCurrency <http://fame.eu/data/currency/USD> ;
    fame:hasTicker "AAPL" ;
    fame:price 185.5 ;
    fame:source "api" ;
    fame:tradedOn <http://fame.eu/data/exchange/NASDAQ> ;
    fame:volume 50000000 .

<http://fame.eu/data/exchange/NASDAQ> a fame:StockExchange ;
    rdfs:label "NASDAQ" .


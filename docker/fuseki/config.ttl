# ═══════════════════════════════════════════════════════════════════════════════
# FAME Financial Data Space - Apache Jena Fuseki Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Enhanced configuration with:
# - Multiple Named Graphs (OWL, RDF, SKOS, Data by source)
# - RDFS/OWL Inference Support
# - Union default graph for cross-graph queries
# - Protégé-compatible ontology loading
# ═══════════════════════════════════════════════════════════════════════════════

@prefix :        <#> .
@prefix fuseki:  <http://jena.apache.org/fuseki#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ja:      <http://jena.hpl.hp.com/2005/11/Assembler#> .
@prefix tdb2:    <http://jena.apache.org/2016/tdb#> .

# ═══════════════════════════════════════════════════════════════════════════════
# FUSEKI SERVICE DEFINITION
# ═══════════════════════════════════════════════════════════════════════════════

:service_fame rdf:type fuseki:Service ;
    fuseki:name                 "fame" ;
    
    # SPARQL Query Endpoints
    fuseki:endpoint [ 
        fuseki:operation fuseki:query ;
        fuseki:name "sparql" 
    ] ;
    fuseki:endpoint [ 
        fuseki:operation fuseki:query ;
        fuseki:name "query" 
    ] ;
    
    # SPARQL Update Endpoint
    fuseki:endpoint [ 
        fuseki:operation fuseki:update ;
        fuseki:name "update" 
    ] ;
    
    # Graph Store Protocol (read)
    fuseki:endpoint [ 
        fuseki:operation fuseki:gsp-r ;
        fuseki:name "get" 
    ] ;
    
    # Graph Store Protocol (read-write)
    fuseki:endpoint [ 
        fuseki:operation fuseki:gsp-rw ;
        fuseki:name "data" 
    ] ;
    
    # File Upload Endpoint
    fuseki:endpoint [ 
        fuseki:operation fuseki:upload ;
        fuseki:name "upload" 
    ] ;
    
    # Dataset with inference
    fuseki:dataset :dataset_fame_inf .

# ═══════════════════════════════════════════════════════════════════════════════
# DATASET WITH RDFS INFERENCE (for reasoning over Protégé ontology)
# ═══════════════════════════════════════════════════════════════════════════════

:dataset_fame_inf rdf:type ja:RDFDataset ;
    ja:defaultGraph :model_inf .

:model_inf rdf:type ja:InfModel ;
    ja:baseModel :model_tdb ;
    ja:reasoner [
        ja:reasonerURL <http://jena.hpl.hp.com/2003/RDFSExptRuleReasoner>
    ] .

:model_tdb rdf:type tdb2:GraphTDB2 ;
    tdb2:dataset :dataset_tdb ;
    tdb2:graphName <urn:x-arq:UnionGraph> .

# ═══════════════════════════════════════════════════════════════════════════════
# TDB2 PERSISTENT STORAGE
# ═══════════════════════════════════════════════════════════════════════════════

:dataset_tdb rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/fame" ;
    tdb2:unionDefaultGraph true .

# ═══════════════════════════════════════════════════════════════════════════════
# NAMED GRAPHS STRUCTURE (for organizing Protégé data in Fuseki)
# ═══════════════════════════════════════════════════════════════════════════════
# 
# Graph URIs:
# http://fame.eu/graph/ontology     - OWL Ontology from Protégé (TBox)
# http://fame.eu/graph/vocabulary   - SKOS Vocabulary (concepts)
# http://fame.eu/graph/rdf-data     - RDF/XML Instance Data
# http://fame.eu/graph/stocks       - Stock market data (Yahoo Finance API)
# http://fame.eu/graph/forex        - Exchange rates (ECB XML)
# http://fame.eu/graph/companies    - Company data (CSV files)
# http://fame.eu/graph/transactions - Transaction data (PostgreSQL)
# http://fame.eu/graph/provenance   - Data lineage tracking
#
# ═══════════════════════════════════════════════════════════════════════════════
